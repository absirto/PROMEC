generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  GESTOR
  ORCAMENTISTA
  OPERADOR
}

enum Vinculo {
  CLT
  PJ
  HORISTA
  SOCIO
}

enum StatusTabela {
  RASCUNHO
  VIGENTE
  ENCERRADA
}

enum TipoPessoa {
  PF
  PJ
}

enum StatusCliente {
  ATIVO
  BLOQUEADO
  INATIVO
}

enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  EM_NEGOCIACAO
  APROVADO
  RECUSADO
  EXPIRADO
  CONVERTIDO
}

enum Segmento {
  OFICINA
  USINAGEM
  CALDEIRARIA
}

model Empresa {
  id       String   @id @default(cuid())
  nome     String
  criadaEm DateTime @default(now())

  usuarios      Usuario[]
  parametros    Parametros?
  colaboradores Colaborador[]
  centros       CentroTrabalho[]
  operadores    CentroOperador[]
  custosFixos   LancamentoCustoFixo[]
  tabelas       TabelaCustos[]
  clientes      Cliente[]
  orcamentos    Orcamento[]
  historicos    OrcamentoHistorico[]
  sequencias    Sequencia[]
  ordens        OrdemServico[]
  osOperacoes   OsOperacao[]
  osCustos      OsCusto[]
  apontamentos  Apontamento[]
  ocorrencias   Ocorrencia[]
  inspecoes     Inspecao[]
  osHistoricos  OsHistorico[]
  feriados      Feriado[]
  paradas       ParadaCentro[]
  agendamentos  Agendamento[]
}

model Usuario {
  id        String   @id @default(cuid())
  tenantId  String
  nome      String
  email     String   @unique
  senhaHash String
  papel     Papel
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  empresa Empresa @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Parametros {
  tenantId              String  @id
  criterioRateio        String  @default("horas")
  metodoPreco           String  @default("divisor")
  impostosPadrao        Decimal @default(0) @db.Decimal(9, 6)
  comissaoPadrao        Decimal @default(0) @db.Decimal(9, 6)
  margemAlvo            Decimal @default(0.2) @db.Decimal(9, 6)
  margemMinima          Decimal @default(0.15) @db.Decimal(9, 6)
  validadeOrcamentoDias Int     @default(15)
  limiteServicoRapido   Decimal @default(1500) @db.Decimal(14, 2)

  empresa Empresa @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Colaborador {
  id           String   @id @default(cuid())
  tenantId     String
  nome         String
  funcao       String   @default("")
  vinculo      Vinculo  @default(CLT)
  salario      Decimal  @default(0) @db.Decimal(14, 2)
  encargos     Decimal  @default(0) @db.Decimal(14, 2)
  beneficios   Decimal  @default(0) @db.Decimal(14, 2)
  jornadaHoras Decimal  @default(220) @db.Decimal(9, 2)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa      Empresa          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  alocacoes    CentroOperador[]
  operacoes    OsOperacao[]
  apontamentos Apontamento[]
  agendamentos Agendamento[]

  @@index([tenantId])
}

model CentroTrabalho {
  id              String   @id @default(cuid())
  tenantId        String
  codigo          String
  nome            String
  tipo            String   @default("maquina")
  status          String   @default("ativo")
  horasExpediente Decimal  @default(220) @db.Decimal(9, 2)
  eficiencia      Decimal  @default(0.75) @db.Decimal(9, 6)
  manutencao      Decimal  @default(0) @db.Decimal(14, 2)
  insumos         Decimal  @default(0) @db.Decimal(14, 2)
  outros          Decimal  @default(0) @db.Decimal(14, 2)
  valorAquisicao  Decimal  @default(0) @db.Decimal(14, 2)
  valorResidual   Decimal  @default(0) @db.Decimal(14, 2)
  vidaUtilMeses   Int      @default(0)
  potenciaKw      Decimal  @default(0) @db.Decimal(12, 4)
  fatorCarga      Decimal  @default(0) @db.Decimal(9, 6)
  tarifaKwh       Decimal  @default(0) @db.Decimal(12, 6)
  pesoManual      Decimal? @db.Decimal(9, 6)
  areaM2          Decimal? @db.Decimal(12, 2)
  diasSemana      Int[]    @default([1, 2, 3, 4, 5])
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  empresa      Empresa          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  operadores   CentroOperador[]
  osOperacoes  OsOperacao[]
  paradas      ParadaCentro[]
  agendamentos Agendamento[]

  @@unique([tenantId, codigo])
}

model CentroOperador {
  tenantId      String
  centroId      String
  colaboradorId String
  alocacao      Decimal @db.Decimal(9, 6)

  empresa     Empresa        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  centro      CentroTrabalho @relation(fields: [centroId], references: [id], onDelete: Cascade)
  colaborador Colaborador    @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@id([centroId, colaboradorId])
  @@index([tenantId])
  @@index([colaboradorId])
}

model LancamentoCustoFixo {
  id           String   @id @default(cuid())
  tenantId     String
  competencia  String
  categoria    String
  descricao    String   @default("")
  valor        Decimal  @db.Decimal(14, 2)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresa Empresa @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, competencia])
}

model TabelaCustos {
  id            String       @id @default(cuid())
  tenantId      String
  competencia   String
  versao        Int
  status        StatusTabela @default(RASCUNHO)
  desatualizada Boolean      @default(false)
  entrada       Json
  resultado     Json
  publicadaEm   DateTime?
  encerradaEm   DateTime?
  criadaEm      DateTime     @default(now())
  atualizadaEm  DateTime     @updatedAt

  empresa    Empresa        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orcamentos Orcamento[]
  ordens     OrdemServico[]

  @@unique([tenantId, competencia, versao])
  @@index([tenantId, status])
}

model Cliente {
  id           String        @id @default(cuid())
  tenantId     String
  tipo         TipoPessoa
  documento    String
  nome         String
  fantasia     String        @default("")
  email        String        @default("")
  telefone     String        @default("")
  cidade       String        @default("")
  uf           String        @default("")
  status       StatusCliente @default(ATIVO)
  observacoes  String        @default("")
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  empresa      Empresa        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orcamentos   Orcamento[]
  ordens       OrdemServico[]
  agendamentos Agendamento[]

  @@unique([tenantId, documento])
}

model Orcamento {
  id                     String          @id @default(cuid())
  tenantId               String
  numero                 String
  clienteId              String
  tabelaCustosId         String
  titulo                 String
  segmento               Segmento
  lote                   Int
  validade               DateTime        @db.Date
  impostos               Decimal         @db.Decimal(9, 6)
  comissao               Decimal         @db.Decimal(9, 6)
  margemAlvo             Decimal         @db.Decimal(9, 6)
  margemMinima           Decimal         @db.Decimal(9, 6)
  desconto               Decimal         @db.Decimal(9, 6)
  metodo                 String          @default("divisor")
  observacoes            String          @default("")
  linhas                 Json
  resultado              Json
  status                 StatusOrcamento @default(RASCUNHO)
  versao                 Int             @default(1)
  precoFinalLote         Decimal         @db.Decimal(18, 10)
  margemEfetiva          Decimal         @db.Decimal(18, 10)
  situacaoMargem         String
  exigeAprovacao         Boolean         @default(false)
  margemLiberada         Boolean         @default(false)
  justificativaLiberacao String?
  liberadaPorId          String?
  motivoRecusa           String?
  enviadoEm              DateTime?
  aprovadoEm             DateTime?
  recusadoEm             DateTime?
  prazoPrometido         DateTime?       @db.Date
  criadoEm               DateTime        @default(now())
  atualizadoEm           DateTime        @updatedAt

  empresa      Empresa              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente      Cliente              @relation(fields: [clienteId], references: [id])
  tabelaCustos TabelaCustos         @relation(fields: [tabelaCustosId], references: [id])
  historico    OrcamentoHistorico[]
  ordem        OrdemServico?

  @@unique([tenantId, numero])
  @@index([tenantId, status])
  @@index([clienteId])
}

model OrcamentoHistorico {
  id             String          @id @default(cuid())
  tenantId       String
  orcamentoId    String
  versao         Int
  status         StatusOrcamento
  evento         String
  precoFinalLote Decimal         @db.Decimal(18, 10)
  usuarioId      String?
  detalhe        String?
  snapshot       Json?
  data           DateTime        @default(now())

  empresa   Empresa   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)

  @@index([orcamentoId])
}

model Sequencia {
  tenantId String
  chave    String
  valor    Int    @default(0)

  empresa Empresa @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, chave])
}

enum StatusOs {
  ABERTA
  EM_FILA
  EM_EXECUCAO
  PAUSADA
  CONTROLE_QUALIDADE
  CONCLUIDA
  ENTREGUE
  CANCELADA
}

enum Prioridade {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

enum StatusOperacao {
  PENDENTE
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
}

enum TipoApontamento {
  SETUP
  PRODUCAO
}

model OrdemServico {
  id                 String     @id @default(cuid())
  tenantId           String
  numero             String
  orcamentoId        String?    @unique
  clienteId          String
  tabelaCustosId     String
  titulo             String
  segmento           Segmento
  lote               Int
  prazo              DateTime   @db.Date
  prioridade         Prioridade @default(NORMAL)
  posicaoFila        Int?
  objeto             Json
  observacoes        String     @default("")
  status             StatusOs   @default(ABERTA)
  precoFinalLote     Decimal    @db.Decimal(18, 10)
  impostos           Decimal    @db.Decimal(9, 6)
  comissao           Decimal    @db.Decimal(9, 6)
  margemMinima       Decimal    @db.Decimal(9, 6)
  custoRealFinal     Decimal?   @db.Decimal(18, 10)
  desvioFinal        Decimal?   @db.Decimal(18, 10)
  recebidoPor        String?
  documentoEntrega   String?
  observacaoEntrega  String?
  entregueEm         DateTime?
  motivoCancelamento String?
  canceladaEm        DateTime?
  criadoEm           DateTime   @default(now())
  atualizadoEm       DateTime   @updatedAt

  empresa      Empresa       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orcamento    Orcamento?    @relation(fields: [orcamentoId], references: [id])
  cliente      Cliente       @relation(fields: [clienteId], references: [id])
  tabelaCustos TabelaCustos  @relation(fields: [tabelaCustosId], references: [id])
  operacoes    OsOperacao[]
  custos       OsCusto[]
  apontamentos Apontamento[]
  ocorrencias  Ocorrencia[]
  inspecoes    Inspecao[]
  historico    OsHistorico[]
  agendamentos Agendamento[]

  @@unique([tenantId, numero])
  @@index([tenantId, status])
}

model OsOperacao {
  id                      String         @id @default(cuid())
  tenantId                String
  osId                    String
  sequencia               Int
  descricao               String
  centroId                String
  colaboradorId           String?
  custoHora               Decimal        @db.Decimal(18, 10)
  setupOrcadoHoras        Decimal        @db.Decimal(12, 4)
  cicloOrcadoHorasPorPeca Decimal        @db.Decimal(12, 6)
  setupConcluido          Boolean        @default(false)
  status                  StatusOperacao @default(PENDENTE)
  retrabalho              Boolean        @default(false)
  orcada                  Boolean        @default(true)
  justificativa           String?
  criadoEm                DateTime       @default(now())

  empresa      Empresa        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  os           OrdemServico   @relation(fields: [osId], references: [id], onDelete: Cascade)
  centro       CentroTrabalho @relation(fields: [centroId], references: [id])
  colaborador  Colaborador?   @relation(fields: [colaboradorId], references: [id])
  apontamentos Apontamento[]

  @@index([osId])
  @@index([tenantId, centroId])
}

model OsCusto {
  id            String   @id @default(cuid())
  tenantId      String
  osId          String
  descricao     String
  categoria     String
  orcado        Decimal  @db.Decimal(18, 10)
  real          Decimal? @db.Decimal(18, 10)
  doOrcamento   Boolean  @default(false)
  justificativa String?
  criadoEm      DateTime @default(now())

  empresa Empresa      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  os      OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  @@index([osId])
}

model Apontamento {
  id            String          @id @default(cuid())
  tenantId      String
  osId          String
  operacaoId    String
  colaboradorId String
  tipo          TipoApontamento
  inicio        DateTime
  fim           DateTime?
  horas         Decimal?        @db.Decimal(12, 6)
  quantidadeBoa Int             @default(0)
  refugo        Int             @default(0)
  observacao    String?

  empresa     Empresa      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  os          OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  operacao    OsOperacao   @relation(fields: [operacaoId], references: [id], onDelete: Cascade)
  colaborador Colaborador  @relation(fields: [colaboradorId], references: [id])

  @@index([osId])
  @@index([tenantId, colaboradorId, fim])
}

model Ocorrencia {
  id         String    @id @default(cuid())
  tenantId   String
  osId       String
  tipo       String
  motivo     String?
  inicio     DateTime  @default(now())
  fim        DateTime?
  horas      Decimal?  @db.Decimal(12, 6)
  observacao String?

  empresa Empresa      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  os      OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  @@index([osId])
}

model Inspecao {
  id                 String   @id @default(cuid())
  tenantId           String
  osId               String
  aprovada           Boolean
  itens              Json
  observacao         String?
  centroRetrabalhoId String?
  usuarioId          String?
  data               DateTime @default(now())

  empresa Empresa      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  os      OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  @@index([osId])
}

model OsHistorico {
  id        String   @id @default(cuid())
  tenantId  String
  osId      String
  status    StatusOs
  evento    String
  detalhe   String?
  usuarioId String?
  data      DateTime @default(now())

  empresa Empresa      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  os      OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)

  @@index([osId])
}

enum StatusAgendamento {
  MARCADO
  CONFIRMADO
  CHEGOU
  NAO_VEIO
  CANCELADO
}

model Feriado {
  id        String   @id @default(cuid())
  tenantId  String
  data      DateTime @db.Date
  descricao String

  empresa Empresa @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, data])
}

model ParadaCentro {
  id       String   @id @default(cuid())
  tenantId String
  centroId String
  inicio   DateTime @db.Date
  fim      DateTime @db.Date
  motivo   String
  criadoEm DateTime @default(now())

  empresa Empresa        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  centro  CentroTrabalho @relation(fields: [centroId], references: [id], onDelete: Cascade)

  @@index([tenantId, centroId])
}

model Agendamento {
  id            String            @id @default(cuid())
  tenantId      String
  clienteId     String?
  nomeCliente   String?
  telefone      String?
  placa         String?
  veiculo       String?
  servico       String
  centroId      String
  colaboradorId String?
  inicio        DateTime
  duracaoHoras  Decimal           @db.Decimal(8, 2)
  status        StatusAgendamento @default(MARCADO)
  osId          String?
  observacao    String?
  criadoEm      DateTime          @default(now())
  atualizadoEm  DateTime          @updatedAt

  empresa     Empresa        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente     Cliente?       @relation(fields: [clienteId], references: [id])
  centro      CentroTrabalho @relation(fields: [centroId], references: [id])
  colaborador Colaborador?   @relation(fields: [colaboradorId], references: [id])
  os          OrdemServico?  @relation(fields: [osId], references: [id], onDelete: SetNull)

  @@index([tenantId, inicio])
  @@index([tenantId, centroId])
}
